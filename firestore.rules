rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      function ownsDocument() {
        return request.auth != null && request.auth.uid == uid;
      }

      function validPreferences() {
        let preferences = request.resource.data;
        return preferences.keys().hasOnly(['favorites', 'updatedAt', 'watchCompanies', 'form4ImportedIssuers'])
          && preferences.get('favorites', []) is list
          && preferences.get('watchCompanies', []) is list
          && preferences.get('watchCompanies', []).size() <= 100
          && preferences.get('form4ImportedIssuers', []) is list
          && preferences.get('form4ImportedIssuers', []).size() <= 10000
          && preferences.get('updatedAt', request.time) is timestamp;
      }

      allow get: if ownsDocument();
      allow create, update: if ownsDocument() && validPreferences();
    }

    match /companyMetricRequests/{key} {
      function eligibleCompany() {
        return key in [
          '0000001800:ABT', '0000002488:AMD', '0000004962:AXP', '0000006281:ADI',
          '0000006951:AMAT', '0000012659:HRB', '0000018230:CAT', '0000019617:JPM',
          '0000021344:KO', '0000040545:GE', '0000040729:ALLY', '0000045012:HAL',
          '0000050863:INTC', '0000059478:LLY', '0000063908:MCD', '0000064040:SPGI',
          '0000070858:BAC', '0000072971:WFC', '0000077476:PEP', '0000078003:PFE',
          '0000080424:PG', '0000080661:PGR', '0000093410:CVX', '0000093751:STT',
          '0000097476:TXN', '0000097745:TMO', '0000100885:UNP', '0000104169:WMT',
          '0000106040:WDC', '0000200406:JNJ', '0000310764:SYK', '0000318154:AMGN',
          '0000319201:KLAC', '0000320187:NKE', '0000320193:AAPL', '0000353278:NVO',
          '0000354950:HD', '0000707549:LRCX', '0000723125:MU', '0000731766:UNH',
          '0000732712:VZ', '0000745308:JOE', '0000750686:CAC', '0000773840:HON',
          '0000788329:JOUT', '0000789019:MSFT', '0000796343:ADBE', '0000797468:OXY',
          '0000804328:QCOM', '0000813672:CDNS', '0000813762:IEP', '0000827054:MCHP',
          '0000858877:CSCO', '0000883241:SNPS', '0000884394:SPY', '0000886982:GS',
          '0000896159:CB', '0000896878:INTU', '0000906345:CPT', '0000909832:COST',
          '0000912892:TV', '0000921738:PENN', '0000937966:ASML', '0001001085:BN',
          '0001014473:VRSN', '0001018724:AMZN', '0001032033:SLM', '0001035267:ISRG',
          '0001041130:DIA', '0001045810:NVDA', '0001046179:TSM', '0001057352:CSGP',
          '0001058090:CMG', '0001059556:MCO', '0001062579:DOX', '0001065280:NFLX',
          '0001067983:BRK-A', '0001067983:BRK-B', '0001075531:BKNG', '0001091667:CHTR',
          '0001097864:ON', '0001099590:MELI', '0001108524:CRM', '0001109354:BRKR',
          '0001137789:STX', '0001141391:MA', '0001157601:MDGL', '0001166691:CMCSA',
          '0001178839:NBH', '0001179929:MOH', '0001222333:GLD', '0001262039:FTNT',
          '0001278680:IAU', '0001280452:MPWR', '0001315098:RBLX', '0001318605:TSLA',
          '0001321655:PLTR', '0001326801:META', '0001327567:PANW', '0001330568:SLV',
          '0001341439:ORCL', '0001370755:TCPC', '0001373715:NOW', '0001375365:SMCI',
          '0001376139:CVI', '0001397187:LULU', '0001403161:V', '0001441816:MDB',
          '0001451505:RIG', '0001467373:ACN', '0001477333:NET', '0001499832:TSQ',
          '0001512673:XYZ', '0001526243:PPTA', '0001535527:CRWD', '0001543151:UBER',
          '0001551152:ABBV', '0001559720:ABNB', '0001561550:DDOG', '0001562088:DUOL',
          '0001571996:DELL', '0001577552:BABA', '0001585689:HLT', '0001594805:SHOP',
          '0001596532:ANET', '0001604821:NTRA', '0001611647:FRPT', '0001613103:MDT',
          '0001633917:PYPL', '0001637459:KHC', '0001639920:SPOT', '0001640147:SNOW',
          '0001652044:GOOG', '0001652044:GOOGL', '0001671933:TTD', '0001679788:COIN',
          '0001691303:HCC', '0001691493:NU', '0001703399:SE', '0001704715:AMR',
          '0001707925:LIN', '0001730168:AVGO', '0001737806:PDD', '0001744489:DIS',
          '0001751008:APP', '0001783879:HOOD', '0001792789:DASH', '0001794776:PSBD',
          '0001807794:CRDO', '0001835632:MRVL', '0001883685:DKNG', '0001945565:BGIN',
          '0001973239:ARM', '0001980994:IBIT', '0001996810:GEV', '0002012383:BLK',
          '0002115436:XOM'
        ];
      }

      // This queue contains security identifiers and a boolean only.
      allow get: if eligibleCompany();
      allow list: if request.query.limit != null && request.query.limit <= 200;
      allow create: if request.auth != null
        && eligibleCompany()
        && request.resource.data.keys().hasOnly(['requested'])
        && request.resource.data.requested == true
        && key in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('watchCompanies', []);
    }
  }
}
